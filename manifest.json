{
  "manifest_version": 3,
  "name": "Copy Page HTML",
  "version": "2.0.0",
  "description": "Copy the current page's complete live HTML to the clipboard with a shortcut.",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Copy Page HTML",
    "default_popup": "popup.html"
  },
  "commands": {
    "copy-page-html": {
      "suggested_key": {
        "default": "Ctrl+Shift+Q",
        "mac": "Command+Shift+Q"
      },
      "description": "Copy current page HTML"
    }
  }
}
