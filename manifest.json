{
  "manifest_version": 3,
  "name": "Copy Page HTML",
  "version": "2.1.0",
  "description": "Copy or save the current webpage's HTML.",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Copy Page HTML",
    "default_popup": "popup.html"
  },
  "commands": {
    "copy-page-html": {
      "suggested_key": {
        "default": "Ctrl+Shift+Q",
        "mac": "Command+Shift+Q"
      },
      "description": "Copy current page HTML"
    },
    "overwrite-html": {
      "suggested_key": {
        "default": "Ctrl+Shift+D",
        "mac": "Command+Shift+D"
      },
      "description": "Overwrite the selected HTML file"
    }
  }
}